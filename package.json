{
  "name": "disruption-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Disruption Companion - vertical slice Backend/Integración (determinístico, sin IA en runtime)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "ts-node src/main.ts",
    "demo": "ts-node src/demo.ts",
    "test": "node --require ts-node/register --test test/*.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
